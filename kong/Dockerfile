# Kong Gateway 3.10 data plane with the guardrail-observer plugin family installed.
#
# Pinned by tag AND digest. kong/kong-gateway runs in free mode without a
# license and bundles the same AI plugins as the OSS 3.10 source tree
# (ai-proxy, ai-prompt-guard, ...). Override KONG_BASE_IMAGE to build on a
# different base (e.g. your own hardened image) — nothing here is base-specific.
ARG KONG_BASE_IMAGE=kong/kong-gateway:3.10.0.19@sha256:a1ce1bc060c1379a5da26db50a2cd1e43db15efbd79b9dff563f18c6e52df282
FROM ${KONG_BASE_IMAGE}

USER root
# Install = copy the Lua modules where Kong's package.path already looks.
COPY plugins/guardrail-observer      /usr/local/share/lua/5.1/kong/plugins/guardrail-observer
COPY plugins/guardrail-observer-tail /usr/local/share/lua/5.1/kong/plugins/guardrail-observer-tail
# Middle probes generated by scripts/gen-probes.sh (one tiny plugin per position in the guardrail chain).
COPY plugins /tmp/all-plugins
RUN for d in /tmp/all-plugins/gro-probe-*; do [ -d "$d" ] && cp -r "$d" /usr/local/share/lua/5.1/kong/plugins/; done; \
    rm -rf /tmp/all-plugins; chown -R kong:0 /usr/local/share/lua/5.1/kong/plugins/gro-probe-* 2>/dev/null || true
# Fixture guardrails are for isolated test environments. Build with
# --build-arg INSTALL_FIXTURES=0 for production images.
ARG INSTALL_FIXTURES=1
COPY plugins/fixture-input-guard     /tmp/fixtures/fixture-input-guard
COPY plugins/fixture-output-guard    /tmp/fixtures/fixture-output-guard
# Stand-in guardrails generated by scripts/gen-demo-guards.sh (marked with a .demo-guard file) are test fixtures too.
COPY plugins /tmp/all-plugins
RUN if [ "$INSTALL_FIXTURES" = "1" ]; then \
      cp -r /tmp/fixtures/* /usr/local/share/lua/5.1/kong/plugins/; \
      for d in /tmp/all-plugins/*; do [ -f "$d/.demo-guard" ] && cp -r "$d" /usr/local/share/lua/5.1/kong/plugins/ && chown -R kong:0 "/usr/local/share/lua/5.1/kong/plugins/$(basename "$d")"; done; \
    fi; rm -rf /tmp/fixtures /tmp/all-plugins \
    && chown -R kong:0 /usr/local/share/lua/5.1/kong/plugins/guardrail-observer* \
    && find /usr/local/share/lua/5.1/kong/plugins -name '*.lua' -path '*guardrail*' -exec chmod 0644 {} +
USER kong

# Activation is a separate step: KONG_PLUGINS must list the plugins
# (bundled,guardrail-observer,guardrail-observer-tail[,fixture-input-guard,fixture-output-guard]),
# then plugin instances are created on the chosen route. See scripts/attach-to-kong.sh.
