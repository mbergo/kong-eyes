# ---- generated/kept by scripts/setup.sh (do not commit .env) ----------------
INGEST_TOKEN=            # Kong http-log -> evaluator (sent as basic auth userinfo in the http-log endpoint)
RUNNER_TOKEN=            # runner -> evaluator API
RUNNER_SECRET=           # HMAC shared secret: runner signs X-Observer-Run; observer verifies
RUNNER_APIKEY=           # key-auth credential for the demo "runner" consumer
KONG_REQUEST_DEBUG_TOKEN= # runner sends X-Kong-Request-Debug: * with this token; Kong records a per-plugin phase trace
ENVIRONMENT=local
OBSERVED_ROUTE=ai-prompt-guard-route
COMPOSE_PROFILES=grafana

# ---- pinned images ------------------------------------------------------------
KONG_BASE_IMAGE=kong/kong-gateway:3.10.0.19@sha256:a1ce1bc060c1379a5da26db50a2cd1e43db15efbd79b9dff563f18c6e52df282
GRAFANA_IMAGE=grafana/grafana:13.2.5
LOKI_IMAGE=grafana/loki:3.6.19
ALLOY_IMAGE=grafana/alloy:v1.21.3
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
KONG_LICENSE_DATA=       # optional; not needed for bundled ai-proxy / ai-prompt-guard (free mode)

# ---- real provider (optional) -------------------------------------------------
KIMI_API_KEY=            # setup.sh also reads $KIMI_API_KEY / $MOONSHOT_API_KEY from your shell
KIMI_BASE_URL=           # auto: sk-kimi-* -> https://api.kimi.com/coding/v1 (Kimi for Coding), else https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3.1-pro
                         # -> enables route /ai/kimi (ai-prompt-guard + ai-proxy -> kimi-k3.1-pro)

# ---- ordinary-traffic checks and plain-language findings (docs/passive-checks.md) ----
EXTRA_KONG_PLUGINS=           # written by scripts/gen-demo-guards.sh (leading comma, e.g. ",my-guard,gro-probe-777")
PASSIVE_WINDOW_S=900
TRANSLATE_PROVIDER=      # anthropic | bedrock | stub (empty = anthropic if a key is set, else bedrock if a model id is set, else stub)
ANTHROPIC_API_KEY=       # Claude API key; only aggregates are sent, never prompts or responses
TRANSLATE_MODEL=claude-sonnet-5-5
BEDROCK_MODEL_ID=        # Claude model or inference-profile id enabled in your AWS account (needs boto3 in the evaluator image)
AWS_REGION=
TRANSLATE_INCLUDE_CONSUMERS=false
DEMO_CONSOLE=false           # true: serve the demo console at /demo (knobs for the stand-in guardrails and mock traffic; localhost only)
EXPORT_PROMPT_CHARS=0        # > 0: export the first N characters of each prompt (only for routes with capture_body_mode: bounded)
TRANSLATE_EVERY_S=0          # > 0: refresh the findings every N seconds while there is traffic (each refresh is one model call)

# ---- Grafana (local) ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTLP_LOGS_ENDPOINT=http://alloy:4318/v1/logs        # evaluator -> Alloy
LOKI_WRITE_URL=http://loki:3100/otlp                # Alloy -> Loki (OTLP ingest)
PROM_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write

# ---- Grafana Cloud (instead of the local Loki/Prometheus) ----------------------
# Keep OTLP_LOGS_ENDPOINT pointing at the local Alloy; Alloy forwards to the cloud.
# LOKI_WRITE_URL=https://otlp-gateway-<region>.grafana.net/otlp          # from your stack's OTLP endpoint page
# PROM_REMOTE_WRITE_URL=https://prometheus-<region>.grafana.net/api/prom/push
# GRAFANA_CLOUD_LOGS_USER=<logs instance id>
# GRAFANA_CLOUD_METRICS_USER=<metrics instance id>
# GRAFANA_CLOUD_TOKEN=<access policy token with logs:write metrics:write>
# (setup.sh derives LOKI_AUTH_HEADER / PROM_AUTH_HEADER from these; leave them empty for local)
# Then import observability/grafana/dashboards/guardrail-observer.json into the cloud stack
# (datasource uids go-prom / go-loki -> map to your cloud datasources on import).

# ---- Splunk HEC ---------------------------------------------------------------
SPLUNK_HEC_URL=          # e.g. https://splunk.example.com:8088  (no path; exporter appends /services/collector/event)
SPLUNK_HEC_TOKEN=        # HEC token (reference to your secret store in production)
SPLUNK_HEC_INDEX=        # optional; empty = token's default index
SPLUNK_HEC_SOURCETYPE=kong:guardrail:evaluation
SPLUNK_HEC_VERIFY_TLS=true
SPLUNK_HEC_CA_FILE=      # optional custom CA bundle path inside the evaluator container
SPLUNK_HEC_ACK=false     # true only if the HEC token has indexer acknowledgement enabled
# search-visibility verification (optional, read access):
SPLUNK_SEARCH_URL=       # e.g. https://splunk.example.com:8089
SPLUNK_SEARCH_TOKEN=     # bearer token for /services/search/jobs

# ---- ports --------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_STATUS_PORT=8100
EVALUATOR_PORT=8800
GRAFANA_PORT=3000
LOKI_PORT=3100
PROMETHEUS_PORT=9090
ALLOY_PORT=12345
OTLP_HTTP_PORT=4318
SPLUNK_STUB_PORT=8088
KONG_LOG_LEVEL=notice
BUILD_CA_SOURCE=      # optional CA bundle (path) trusted by pip during image builds (corporate proxies); setup.sh copies it to .build/ca.crt
