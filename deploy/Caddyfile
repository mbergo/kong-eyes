# HTTPS front for a public install. EYES_DOMAIN comes from .env (deploy/install.sh --https).
#
# People sign in once on the collector's own sign-in page (evaluator/app/frontdoor.py); the X-Front-Door header
# tells the collector that a request came in from outside and must carry a session. Two paths are for machines:
#   /ingest/*  gateways post events here with the collector's token
#   /kong/*    the demo Kong, which asks for its own API key
{$EYES_DOMAIN} {
	encode gzip
	handle_path /kong/* {
		reverse_proxy kong:8000
	}
	handle {
		reverse_proxy evaluator:8000 {
			header_up X-Front-Door 1
		}
	}
}
