{
 "uid": "guardrail-live",
 "title": "Guardrail chain - live traffic",
 "tags": [
  "kong",
  "guardrail",
  "ai",
  "live"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-20m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "route",
    "label": "Route",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "go-prom"
    },
    "query": {
     "query": "label_values(go_live_requests, route)",
     "refId": "v"
    },
    "definition": "label_values(go_live_requests, route)",
    "includeAll": true,
    "multi": true,
    "refresh": 2,
    "sort": 1,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "guardrail",
    "label": "Guardrail",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "go-prom"
    },
    "query": {
     "query": "label_values(go_live_guardrail_reached, guardrail)",
     "refId": "v"
    },
    "definition": "label_values(go_live_guardrail_reached, guardrail)",
    "includeAll": true,
    "multi": true,
    "refresh": 2,
    "sort": 1,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "**Signals, not verdicts.** Ordinary traffic carries no labels, so nothing here proves a guardrail right or wrong: each number is a place to look. Values are recomputed over the evaluator's sliding window (`PASSIVE_WINDOW_S`). Evidence behind every number: evaluator `/passive/summary`. The same chain drawn in 3D: evaluator `/chain`."
   },
   "transparent": true
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requests in window",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "go-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(go_live_requests{route=~\"$route\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Stopped in the gateway",
   "description": "Share of requests that ended inside Kong, whichever plugin ended them.",
   "datasource": {
    "type": "prometheus",
    "uid": "go-prom"
   },
   "gridPos": {
    "x": 3,
    "y": 2,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(go_live_route_blocked{route=~\"$route\"}) / sum(go_live_requests{route=~\"$route\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "red",
        "value": 0.4
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Signals to check",
   "description": "Signals marked warn. Kinds are listed under Signals below.",
   "datasource": {
    "type": "prometheus",
    "uid": "go-prom"
   },
   "gridPos": {
    "x": 6,
    "y": 2,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(go_live_signals{severity=\"warn\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
