   "id": 11,
   "type": "bargauge",
   "title": "Stopped or altered, share of requests that reached it",
   "description": "(blocked + altered) / reached. High could be an attack wave or overcatching: sample the affected requests.",
   "datasource": {
    "type": "prometheus",
    "uid": "go-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "go_live_guardrail_block_rate{guardrail=~\"$guardrail\", guardrail!=\"header-guardrail\"}",
     "refId": "A",
     "instant": true,
     "legendFormat": "{{guardrail}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
