   "targets": [
    {
     "expr": "go_live_guardrail_fail_open_suspects{guardrail=~\"$guardrail\", guardrail!=\"header-guardrail\"}",
     "legendFormat": "fail-open? {{guardrail}}",
     "refId": "A"
    },
    {
     "expr": "go_live_guardrail_no_verdict{guardrail=~\"$guardrail\", guardrail!=\"header-guardrail\"} > 0",
     "legendFormat": "no decision {{guardrail}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
